#!/bin/bash
# close-tab: close the terminal tab that hosts the current agent session.
#
#   close-tab hook-prompt          UserPromptSubmit hook: prompt starts/ends with `/q` -> arm; else disarm
#   close-tab hook-stop            Stop hook: if armed, notify with the status line and close the tab
#   close-tab cancel               disarm
#   close-tab now [secs] [status]  notify and close in `secs` (default 2); for agents without hooks
#
# Finds the topmost ancestor on a tty (below `login`) = the tab's shell, and SIGHUPs it.
# Env: Q_DELAY (default 2), Q_DRY_RUN=1 (print the target, close nothing).

set -u
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/agent-quit"

notify() {
  [ "${Q_DRY_RUN:-}" = 1 ] && return
  osascript -e 'on run a' -e 'display notification (item 1 of a) with title "Claude /q"' -e 'end run' \
    "$(printf '%s' "$1" | tr -d '\000-\037' | cut -c1-140)" >/dev/null 2>&1
}

fire() {
  if [ "${Q_DRY_RUN:-}" = 1 ]; then echo "would close shell $SHELL_PID in ${1}s"; return; fi
  # detached in its own session so it outlives the agent
  perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' \
    /bin/sh -c "sleep $1; kill -HUP $SHELL_PID" >/dev/null 2>&1 </dev/null &
}

case "${1:-}" in
  hook-prompt|hook-stop|cancel|now) ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

SHELL_PID=$(ps -axo pid=,ppid=,tty=,comm= | awk -v p=$$ '
  { pp[$1] = $2; tt[$1] = $3; c = $4; sub(/.*\//, "", c); sub(/^-/, "", c); cm[$1] = c }
  END { while ((p = pp[p]) > 1) { if (tt[p] == "??") { if (s) break; continue }
                                  if (cm[p] == "login") break; s = p }
        print s }')
[ -n "$SHELL_PID" ] || { echo "close-tab: no terminal tab above this process" >&2; exit 1; }
mkdir -p "$STATE"
MARK="$STATE/$SHELL_PID"

case "$1" in
  cancel) rm -f "$MARK"; echo disarmed ;;
  now)    notify "${3:-Done}"; fire "${2:-2}" ;;
  hook-prompt)
    prompt=$(jq -r '.prompt // ""')
    if [[ $prompt =~ ^[[:space:]]*/q([[:space:]]|$) || $prompt =~ (^|[[:space:]])/q[[:space:]]*$ ]]; then
      : > "$MARK"
      jq -n '{hookSpecificOutput:{hookEventName:"UserPromptSubmit",additionalContext:"В промпте есть команда /q (в начале или в конце; сама она не часть задачи). Выполни задачу полностью, без уточняющих вопросов. Вкладка терминала уже взведена на закрытие после твоего ответа, ничего для этого не запускай. Финальный ответ: ОДНА короткая строка-статус (что сделано / чем кончилось), без хвоста про закрытие, она уйдёт уведомлением в терминал. Если без пользователя не обойтись (решение, блокер) — запусти $HOME/.claude/skills/q/close-tab cancel, задай вопрос и не закрывай вкладку."}}'
    else
      rm -f "$MARK"
    fi ;;
  hook-stop)
    # fresh marker only: a stale one (interrupted /q) is ignored
    if [ -n "$(find "$MARK" -mmin -60 2>/dev/null)" ]; then
      rm -f "$MARK"
      status=$(jq -r '.last_assistant_message // ""' | grep -v '^[[:space:]]*$' | head -1)
      notify "${status:-Done}"
      fire "${Q_DELAY:-2}"
    fi ;;
esac
exit 0
